<Window x:Class="VortexArena.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VortexArena.Launcher.ViewModels"
        xmlns:views="clr-namespace:VortexArena.Launcher.Views"
        Title="VortexArena Launcher"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource OnSurfaceBrush}"
        Icon="{StaticResource AppIcon}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ServerPageViewModel}">
            <views:ServerPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminPageViewModel}">
            <views:AdminPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsPageViewModel}">
            <views:VersionsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecordingPageViewModel}">
            <views:RecordingPage />
        </DataTemplate>

        <!-- Kenar çubuğu öğesi: ikon + ad + durum işareti -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItemViewModel}">
            <Button Style="{StaticResource NavButton}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Style="{StaticResource SmallIcon}"
                          Width="18" Height="18"
                          VerticalAlignment="Center"
                          Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}" />

                    <TextBlock Grid.Column="1"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               FontSize="13.5"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{Binding Title}" />

                    <Grid Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center">
                        <!-- çalışıyor -->
                        <Path Width="9" Height="10" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{StaticResource SuccessBrush}"
                              Data="M0,0 L8,5 L0,10 Z"
                              Visibility="{Binding Indicator, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Running}" />

                        <!-- başlıyor / kapanıyor -->
                        <Ellipse Width="9" Height="9"
                                 Fill="{StaticResource WarningBrush}"
                                 Visibility="{Binding Indicator, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Pending}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.25" Duration="0:0:0.7"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- kayıt: dosya açık -->
                        <Ellipse Width="9" Height="9"
                                 Fill="{StaticResource RecordBrush}"
                                 Visibility="{Binding Indicator, Converter={StaticResource EqualsToVisibility}, ConverterParameter=RecordingActive}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.15" Duration="0:0:0.55"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- kayıt: açık ama lobide bekliyor -->
                        <Ellipse Width="9" Height="9"
                                 Stroke="{StaticResource RecordBrush}"
                                 StrokeThickness="1.8"
                                 Fill="Transparent"
                                 Visibility="{Binding Indicator, Converter={StaticResource EqualsToVisibility}, ConverterParameter=RecordingArmed}" />

                        <!-- gözlük bağlı -->
                        <Path Width="14" Height="10" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6"
                              Fill="Transparent"
                              Data="{StaticResource IconHeadset}"
                              Visibility="{Binding Indicator, Converter={StaticResource EqualsToVisibility}, ConverterParameter=DeviceReady}" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════ kenar çubuğu ══════ -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceTopBrush}"
                BorderBrush="{StaticResource OutlineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,20,18,18">
                    <Path Style="{StaticResource Icon}"
                          Width="26" Height="26"
                          Stroke="{StaticResource PrimaryBrush}"
                          StrokeThickness="2"
                          Data="{StaticResource IconLogo}" />
                    <TextBlock Text="{Binding ProductName}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap" />
                </StackPanel>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding NavItems}"
                              ItemTemplate="{StaticResource NavItemTemplate}" />

                <StackPanel Grid.Row="2" Margin="18,12,18,16">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="{Binding VersionText}"
                               TextWrapping="NoWrap" />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding RootText}"
                               ToolTip="{Binding RootTooltip}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ sayfa ═════ -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
