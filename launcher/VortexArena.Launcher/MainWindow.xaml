<Window x:Class="VortexArena.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VortexArena Launcher"
        Width="820" Height="900"
        MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel MaxWidth="760" Margin="24">

            <!-- ══════════════════════════════════════════════════════ başlık ═══ -->
            <TextBlock Style="{StaticResource TitleText}" Text="VortexArena Launcher" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,20"
                       Text="İşletmede açılan tek program. Sunucuyu doğru mekanla, yönetim oyununu doğru adresle başlatır." />

            <!-- ═══════════════════════════════════════════════ 1 · SUNUCU ══════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="1 · Sunucu" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="Maçın tek otoritesi. Kendi konsol penceresinde açılır — kapatmak için o pencerede Ctrl+C." />

                    <TextBlock Style="{StaticResource LabelText}" Margin="0,16,0,4" Text="Sunucu exe" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerExeBox" IsReadOnly="True"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 Text="Seçilmedi" />
                        <Button x:Name="BrowseServerButton" Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource OutlinedButton}" Content="Gözat"
                                Click="BrowseServerButton_Click" />
                    </Grid>
                    <TextBlock x:Name="ServerExeWarning" Visibility="Collapsed" Margin="0,6,0,0"
                               FontSize="12" Foreground="{StaticResource ErrorBrush}"
                               Text="Dosya bulunamıyor — sunucu dağıtımı silinmiş veya taşınmış." />

                    <Grid Margin="0,18,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LabelText}" VerticalAlignment="Center"
                                   Margin="0" Text="Mekan (venue) — sunucuya --venue ile geçer" />
                        <Button x:Name="RefreshVenuesButton" Grid.Column="1"
                                Style="{StaticResource OutlinedButton}" Padding="12,4"
                                Content="Yenile" Click="RefreshVenuesButton_Click" />
                    </Grid>

                    <ListBox x:Name="VenueList"
                             Style="{StaticResource VenueListBox}"
                             ItemContainerStyle="{StaticResource VenueListItem}"
                             SelectionChanged="VenueList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLobby}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBox x:Name="VenueManualBox" Visibility="Collapsed"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             TextChanged="VenueManualBox_TextChanged" />

                    <TextBlock x:Name="VenueHint" Style="{StaticResource HintText}" Margin="0,8,0,0" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartServerButton" Style="{StaticResource FilledButton}"
                                Click="StartServerButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Sunucuyu Başlat" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ServerLogButton" Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource OutlinedButton}" Content="Klasörü Aç"
                                Click="ServerLogButton_Click" />
                    </Grid>
                    <TextBlock x:Name="ServerRunState" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════ 2 · BAĞLANTI ═══════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="2 · Bağlantı" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="Yönetim oyunu bu adrese bağlanır. Adres oyuna komut satırından geçer — oyun içinde IP sorulmaz." />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource LabelText}" Text="Sunucu IP" />
                            <TextBox x:Name="IpBox" TextChanged="IpBox_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource LabelText}" Text="Port" />
                            <TextBox x:Name="PortBox" PreviewTextInput="PortBox_PreviewTextInput"
                                     TextChanged="PortBox_TextChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════ 3 · YÖNETİM OYUNU ════════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="3 · Yönetim oyunu" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="Admin (gözlemci) Windows build'i. scripts\deploy-admin-game.bat bunu deploy\admin\ altına üretir." />

                    <TextBlock Style="{StaticResource LabelText}" Margin="0,16,0,4" Text="Admin exe" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AdminExeBox" IsReadOnly="True"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 Text="Seçilmedi" />
                        <Button x:Name="BrowseAdminButton" Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource OutlinedButton}" Content="Gözat"
                                Click="BrowseAdminButton_Click" />
                    </Grid>
                    <TextBlock x:Name="AdminExeWarning" Visibility="Collapsed" Margin="0,6,0,0"
                               FontSize="12" Foreground="{StaticResource ErrorBrush}"
                               Text="Dosya bulunamıyor — build silinmiş veya taşınmış." />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartGameButton" Style="{StaticResource FilledButton}"
                                Click="StartGameButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock x:Name="StartGameLabel" Text="Yönetimi Başlat"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopGameButton" Grid.Column="1" Margin="8,0,0,0"
                                IsEnabled="False" Style="{StaticResource OutlinedButton}"
                                Content="Durdur" Click="StopGameButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════ durum satırı ═════ -->
            <Border x:Name="StatusBanner" Visibility="Collapsed" CornerRadius="8"
                    Padding="14" Margin="0,4,0,0"
                    Background="{StaticResource SurfaceHighBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusIcon" FontFamily="{StaticResource IconFont}"
                               FontSize="14" Margin="0,1,10,0" Text="&#xE946;"
                               Foreground="{StaticResource OnSurfaceVariantBrush}" />
                    <TextBox x:Name="StatusText" Grid.Column="1" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             TextWrapping="Wrap" FontSize="13" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0"
                       Text="Ayarlar kullanıcı profilinde saklanır; launcher klasörü yeniden dağıtılsa da korunur." />
        </StackPanel>
    </ScrollViewer>
</Window>
