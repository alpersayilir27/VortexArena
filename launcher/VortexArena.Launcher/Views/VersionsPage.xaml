<UserControl x:Class="VortexArena.Launcher.Views.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:VortexArena.Launcher.Services"
             xmlns:vm="clr-namespace:VortexArena.Launcher.ViewModels">

    <UserControl.Resources>
        <!-- Sürüm satırı -->
        <DataTemplate x:Key="VersionRowTemplate" DataType="{x:Type vm:VersionRowViewModel}">
            <Border Style="{StaticResource ListRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               Text="{Binding VersionLabel}" />

                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="NoWrap">
                            <Run Text="{Binding DateText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding SizeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,3,0,0"
                                   TextWrapping="NoWrap"
                                   Text="{Binding StatusText}"
                                   Visibility="{Binding StatusText, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>

                    <!-- rozetler -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource SmallIcon}"
                              Margin="0,0,10,0"
                              Stroke="{StaticResource WarningBrush}"
                              Data="{StaticResource IconCloudOff}"
                              ToolTip="{Binding CloudTooltip}"
                              Visibility="{Binding CloudWarning, Converter={StaticResource BoolToVisibility}}" />

                        <Path Style="{StaticResource SmallIcon}"
                              Margin="0,0,10,0"
                              Stroke="{StaticResource OnSurfaceVariantBrush}"
                              Data="{StaticResource IconDownloaded}"
                              ToolTip="Bu bilgisayarda indirili"
                              Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}" />

                        <Border Style="{StaticResource Badge}"
                                Margin="0,0,10,0"
                                Background="#337FD69A"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource BadgeText}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="Yüklü" />
                        </Border>
                    </StackPanel>

                    <!-- eylemler -->
                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallOutlinedButton}"
                                Margin="0,0,8,0"
                                Content="İndir"
                                Command="{Binding DownloadCommand}"
                                Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <Button Style="{StaticResource SmallFilledButton}"
                                Margin="0,0,8,0"
                                Content="Cihaza yükle"
                                Command="{Binding InstallCommand}" />

                        <Button Style="{StaticResource SmallOutlinedButton}"
                                Content="İptal"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="4"
                                 Margin="0,10,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DeviceItemTemplate" DataType="{x:Type services:AdbDevice}">
            <TextBlock Text="{Binding Display}" TextWrapping="NoWrap" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="{Binding Description}" />
        </StackPanel>

        <!-- liste alınamadı bandı -->
        <Border Grid.Row="1" Style="{StaticResource WarningStrip}" Margin="0,18,0,0"
                Visibility="{Binding HasListError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding ListError}" />
                <Button Grid.Column="1"
                        Style="{StaticResource SmallOutlinedButton}"
                        Margin="12,0,0,0"
                        Content="Yeniden dene"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <!-- gözlük kartı -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Style="{StaticResource Icon}"
                      Width="26" Height="26"
                      VerticalAlignment="Center"
                      Data="{StaticResource IconHeadset}" />

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource LabelText}" Text="GÖZLÜK" />
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding DeviceStateText}" />
                </StackPanel>

                <ComboBox Grid.Column="2"
                          Width="240"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"
                          ItemsSource="{Binding Devices}"
                          ItemTemplate="{StaticResource DeviceItemTemplate}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          Visibility="{Binding HasManyDevices, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource SmallOutlinedButton}"
                            Margin="0,0,8,0"
                            Command="{Binding OpenFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SmallIcon}"
                                  Stroke="{StaticResource PrimaryBrush}"
                                  Data="{StaticResource IconFolder}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="Klasör" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallOutlinedButton}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SmallIcon}"
                                  Stroke="{StaticResource PrimaryBrush}"
                                  Data="{StaticResource IconRefresh}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="Yenile" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- sürüm listesi -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12"
                  Visibility="{Binding Message, Converter={StaticResource TextToVisibility}}">
                <Border Style="{StaticResource ErrorStrip}"
                        Visibility="{Binding MessageIsError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" />
                </Border>
                <Border Style="{StaticResource InfoStrip}"
                        Visibility="{Binding MessageIsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock Text="{Binding Message}" />
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource VersionRowTemplate}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
