<UserControl x:Class="VortexArena.Launcher.Views.AdminPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="{Binding Description}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0"
              Visibility="{Binding Message, Converter={StaticResource TextToVisibility}}">
            <Border Style="{StaticResource ErrorStrip}"
                    Visibility="{Binding MessageIsError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" />
            </Border>
            <Border Style="{StaticResource InfoStrip}"
                    Visibility="{Binding MessageIsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="{Binding Message}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource ErrorStrip}"
                        Visibility="{Binding MissingAdminMessage, Converter={StaticResource TextToVisibility}}">
                    <TextBlock Text="{Binding MissingAdminMessage}" Foreground="{StaticResource ErrorBrush}" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelText}" Text="YÖNETİM UYGULAMASI" />
                                <TextBlock FontSize="22" TextWrapping="NoWrap" Text="{Binding RunStateText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                           Text="{Binding ServerHint}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource FilledButton}"
                                        Content="Başlat"
                                        Command="{Binding StartCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <Button Style="{StaticResource OutlinedButton}"
                                        Content="Durdur"
                                        Command="{Binding StopCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,18,0,16" Background="{StaticResource OutlineBrush}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="BAĞLANACAĞI SUNUCU" />
                        <TextBlock Style="{StaticResource MonoText}" FontSize="14" Text="{Binding TargetText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Expander Header="Gelişmiş">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Sunucu bu bilgisayarda çalıştığı için adres 127.0.0.1'dir. Değiştirilen adres yalnız bu oturumda geçerlidir; launcher her açılışta 127.0.0.1 ile başlar. Port sunucu sayfasındaki kaynaktan gelir." />
                            <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,4" Text="SUNUCU IP" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="180" Text="{Binding IpText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Style="{StaticResource SmallOutlinedButton}"
                                        Margin="8,0,0,0"
                                        Content="Uygula"
                                        Command="{Binding ApplyAddressCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
