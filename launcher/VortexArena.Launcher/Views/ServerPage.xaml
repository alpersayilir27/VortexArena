<UserControl x:Class="VortexArena.Launcher.Views.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:VortexArena.Launcher.Services">

    <UserControl.Resources>
        <!-- Tek istatistik bloğu: üstte etiket, altta değer -->
        <Style x:Key="StatPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,36,10" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ başlık ══ -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="{Binding Description}" />
        </StackPanel>

        <!-- ════════════════════════════════════════════════════ durum mesajı ══ -->
        <Grid Grid.Row="1" Margin="0,18,0,0"
              Visibility="{Binding Message, Converter={StaticResource TextToVisibility}}">
            <Border Style="{StaticResource ErrorStrip}"
                    Visibility="{Binding MessageIsError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" />
            </Border>
            <Border Style="{StaticResource InfoStrip}"
                    Visibility="{Binding MessageIsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="{Binding Message}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- server klasörü yoksa boş durum -->
                <Border Style="{StaticResource ErrorStrip}"
                        Visibility="{Binding MissingServerMessage, Converter={StaticResource TextToVisibility}}">
                    <TextBlock Text="{Binding MissingServerMessage}" Foreground="{StaticResource ErrorBrush}" />
                </Border>

                <!-- ═══════════════════════════════════════════════════ durum ══ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelText}" Text="SUNUCU DURUMU" />
                                <TextBlock FontSize="22" TextWrapping="NoWrap" Text="{Binding RunStateText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunState}" Value="Running">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunState}" Value="Starting">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunState}" Value="Stopping">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunState}" Value="Incompatible">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource FilledButton}"
                                        Content="Başlat"
                                        Command="{Binding StartCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <Button Style="{StaticResource OutlinedButton}"
                                        Content="Durdur"
                                        Command="{Binding StopCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,18,0,16" Background="{StaticResource OutlineBrush}" />

                        <WrapPanel>
                            <StackPanel Style="{StaticResource StatPanel}">
                                <TextBlock Style="{StaticResource LabelText}" Text="MEKAN" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding VenueText}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource StatPanel}">
                                <TextBlock Style="{StaticResource LabelText}" Text="FAZ" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding PhaseText}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource StatPanel}">
                                <TextBlock Style="{StaticResource LabelText}" Text="MOD" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding ModeText}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource StatPanel}">
                                <TextBlock Style="{StaticResource LabelText}" Text="SAHNE" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding SceneText}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource StatPanel}">
                                <TextBlock Style="{StaticResource LabelText}" Text="OYUNCU" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding PlayersText}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource StatPanel}">
                                <TextBlock Style="{StaticResource LabelText}" Text="YÖNETİM" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding AdminsText}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource StatPanel}">
                                <TextBlock Style="{StaticResource LabelText}" Text="ÇALIŞMA SÜRESİ" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding UptimeText}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════ mekan ══ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="Mekan" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,12"
                                   Text="Sunucu yalnız seçili mekanın haritalarını oynatır. Çalışırken değiştirilemez." />

                        <ComboBox ItemsSource="{Binding Venues}"
                                  SelectedItem="{Binding SelectedVenue, Mode=TwoWay}"
                                  IsEnabled="{Binding VenuePickerEnabled}"
                                  MaxDropDownHeight="260">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:VenueInfo}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Summary}" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding CatalogProblem}"
                                   Visibility="{Binding CatalogProblem, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════ günlük ══ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="Canlı günlük" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                           Text="Sunucunun en yeni günlük dosyasının sonu. Yukarı kaydırırsanız otomatik takip durur." />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SmallOutlinedButton}"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenLogsFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SmallIcon}"
                                          Stroke="{StaticResource PrimaryBrush}"
                                          Data="{StaticResource IconFolder}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="Günlük klasörünü aç" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBox x:Name="LogBox"
                                 Style="{StaticResource LogTextBox}"
                                 Margin="0,12,0,0"
                                 Height="220"
                                 Text="{Binding LogText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════════════ gelişmiş ══ -->
                <Border Style="{StaticResource Card}">
                    <Expander Header="Gelişmiş">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding PortSummary}" />
                            <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,4" Text="KONTROL PORTU" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="120" Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Style="{StaticResource SmallOutlinedButton}"
                                        Margin="8,0,0,0"
                                        Content="Uygula"
                                        Command="{Binding ApplyPortCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
